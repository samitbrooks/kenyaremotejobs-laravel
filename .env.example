APP_NAME=KenyaRemoteJobs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Ivy from Kenya Remote Jobs"

# 'mock' auto-completes every purchase with no real charge (default, used in
# local dev). Set to 'mpesa' to charge for real via Safaricom Daraja — see
# App\Payments\DarajaGateway.
PAYMENT_GATEWAY=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# sandbox or live
MPESA_ENVIRONMENT=sandbox
# Must be the full public URL ending in /webhooks/mpesa/callback/{MPESA_CALLBACK_SECRET}
MPESA_CALLBACK_URL=
# Random string — Safaricom sends no signature to verify a callback is
# genuinely theirs, so this is embedded in MPESA_CALLBACK_URL instead and
# checked by Webhooks\MpesaCallbackController. Generate with:
# php -r "echo bin2hex(random_bytes(20));"
MPESA_CALLBACK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Indexing API for rapid JobPosting crawling & indexing
# Place the service account JSON key at storage/app/google-indexing-key.json
# or pass the JSON string directly into GOOGLE_INDEXING_CREDENTIALS.
GOOGLE_INDEXING_KEY_PATH=storage/app/google-indexing-key.json
# GOOGLE_INDEXING_CREDENTIALS=

# Telegram Channel, Group & Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KenyaRemoteJobsBot
TELEGRAM_CHANNEL_ID=@kenyaremotejobs
TELEGRAM_GROUP_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
